<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <!-- Share a link from YouTube/browser: the reliable add path. -->
        <intent-filter>
            <action android:name="android.intent.action.SEND" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="text/plain" />
        </intent-filter>
      </activity>

      <!-- ADR 0014: optional YouTube VIEW handler. Declared disabled; the
           parent setting flips this alias on/off at runtime. Kept separate from
           MainActivity so disabling really removes KidsTube from the system's
           link-handling candidates. No autoVerify / Digital Asset Links: we do
           not control youtube.com. -->
      <activity-alias
        android:name=".YouTubeLinkHandlerActivity"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:exported="true"
        android:enabled="false">
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />

            <!-- Films: /watch?v=…, /shorts/…, /live/…, /embed/… -->
            <data android:scheme="https" android:host="youtube.com" android:pathPattern="/watch" />
            <data android:scheme="https" android:host="www.youtube.com" android:pathPattern="/watch" />
            <data android:scheme="https" android:host="m.youtube.com" android:pathPattern="/watch" />
            <data android:scheme="https" android:host="music.youtube.com" android:pathPattern="/watch" />
            <data android:scheme="https" android:host="youtube-nocookie.com" android:pathPattern="/watch" />
            <data android:scheme="https" android:host="www.youtube-nocookie.com" android:pathPattern="/watch" />

            <data android:scheme="https" android:host="youtube.com" android:pathPrefix="/shorts/" />
            <data android:scheme="https" android:host="www.youtube.com" android:pathPrefix="/shorts/" />
            <data android:scheme="https" android:host="m.youtube.com" android:pathPrefix="/shorts/" />
            <data android:scheme="https" android:host="music.youtube.com" android:pathPrefix="/shorts/" />
            <data android:scheme="https" android:host="youtube-nocookie.com" android:pathPrefix="/shorts/" />
            <data android:scheme="https" android:host="www.youtube-nocookie.com" android:pathPrefix="/shorts/" />

            <data android:scheme="https" android:host="youtube.com" android:pathPrefix="/live/" />
            <data android:scheme="https" android:host="www.youtube.com" android:pathPrefix="/live/" />
            <data android:scheme="https" android:host="m.youtube.com" android:pathPrefix="/live/" />
            <data android:scheme="https" android:host="music.youtube.com" android:pathPrefix="/live/" />
            <data android:scheme="https" android:host="youtube-nocookie.com" android:pathPrefix="/live/" />
            <data android:scheme="https" android:host="www.youtube-nocookie.com" android:pathPrefix="/live/" />

            <data android:scheme="https" android:host="youtube.com" android:pathPrefix="/embed/" />
            <data android:scheme="https" android:host="www.youtube.com" android:pathPrefix="/embed/" />
            <data android:scheme="https" android:host="m.youtube.com" android:pathPrefix="/embed/" />
            <data android:scheme="https" android:host="music.youtube.com" android:pathPrefix="/embed/" />
            <data android:scheme="https" android:host="youtube-nocookie.com" android:pathPrefix="/embed/" />
            <data android:scheme="https" android:host="www.youtube-nocookie.com" android:pathPrefix="/embed/" />

            <!-- Channels: /channel/UC…, /@handle, /c/…, /user/… -->
            <data android:scheme="https" android:host="youtube.com" android:pathPrefix="/channel/" />
            <data android:scheme="https" android:host="www.youtube.com" android:pathPrefix="/channel/" />
            <data android:scheme="https" android:host="m.youtube.com" android:pathPrefix="/channel/" />
            <data android:scheme="https" android:host="music.youtube.com" android:pathPrefix="/channel/" />
            <data android:scheme="https" android:host="youtube-nocookie.com" android:pathPrefix="/channel/" />
            <data android:scheme="https" android:host="www.youtube-nocookie.com" android:pathPrefix="/channel/" />

            <data android:scheme="https" android:host="youtube.com" android:pathPrefix="/@" />
            <data android:scheme="https" android:host="www.youtube.com" android:pathPrefix="/@" />
            <data android:scheme="https" android:host="m.youtube.com" android:pathPrefix="/@" />
            <data android:scheme="https" android:host="music.youtube.com" android:pathPrefix="/@" />
            <data android:scheme="https" android:host="youtube-nocookie.com" android:pathPrefix="/@" />
            <data android:scheme="https" android:host="www.youtube-nocookie.com" android:pathPrefix="/@" />

            <data android:scheme="https" android:host="youtube.com" android:pathPrefix="/c/" />
            <data android:scheme="https" android:host="www.youtube.com" android:pathPrefix="/c/" />
            <data android:scheme="https" android:host="m.youtube.com" android:pathPrefix="/c/" />
            <data android:scheme="https" android:host="music.youtube.com" android:pathPrefix="/c/" />
            <data android:scheme="https" android:host="youtube-nocookie.com" android:pathPrefix="/c/" />
            <data android:scheme="https" android:host="www.youtube-nocookie.com" android:pathPrefix="/c/" />

            <data android:scheme="https" android:host="youtube.com" android:pathPrefix="/user/" />
            <data android:scheme="https" android:host="www.youtube.com" android:pathPrefix="/user/" />
            <data android:scheme="https" android:host="m.youtube.com" android:pathPrefix="/user/" />
            <data android:scheme="https" android:host="music.youtube.com" android:pathPrefix="/user/" />
            <data android:scheme="https" android:host="youtube-nocookie.com" android:pathPrefix="/user/" />
            <data android:scheme="https" android:host="www.youtube-nocookie.com" android:pathPrefix="/user/" />

            <!-- Short links and the custom Android scheme. -->
            <data android:scheme="https" android:host="youtu.be" android:pathPrefix="/" />
            <data android:scheme="vnd.youtube" />
        </intent-filter>
      </activity-alias>
    </application>
</manifest>
